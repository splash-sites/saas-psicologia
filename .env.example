NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Apenas uso server-side. Nunca expor no frontend.
SUPABASE_SERVICE_ROLE_KEY=

# Integração Google Calendar / Meet (módulo 5).
# Client OAuth do Google Cloud (mesmo usado no provider do Supabase Auth).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Chave AES-256-GCM (32 bytes em base64) para cifrar o refresh token do Google.
# Gerar: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
GOOGLE_TOKEN_ENC_KEY=

# Assinatura via Asaas (módulo 2). Sem ASAAS_API_KEY, roda em modo simulado —
# nenhuma chamada real, útil pra testar o fluxo sem conta no Asaas.
ASAAS_API_KEY=
# sandbox | production | mock. Sem isso: mock se não houver chave, senão sandbox.
ASAAS_MODE=
# Token que você mesma escolhe e cadastra no painel do Asaas (Configurações
# → Webhooks) — ele reenvia esse valor no header asaas-access-token.
ASAAS_WEBHOOK_TOKEN=

# Somente para os testes de isolamento RLS (tests/rls/), apontando para o
# Supabase local (`npx supabase start`). Deixe vazio para pular esses testes.
SUPABASE_TEST_URL=
SUPABASE_TEST_ANON_KEY=
# Só necessária para o teste da trava de escrita por assinatura (liga/desliga
# app_config.assinatura_enforcement_ativo). Sem ela, esse teste específico é pulado.
SUPABASE_TEST_SERVICE_ROLE_KEY=
